{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.29/MicrosoftTeams.schema.json",
  "manifestVersion": "1.29",
  "version": "1.0.0",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "My App, Inc.",
    "websiteUrl": "https://www.example.com",
    "privacyUrl": "https://www.example.com/privacy",
    "termsOfUseUrl": "https://www.example.com/termofuse"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "Microsoft Learn Helper${{APP_NAME_SUFFIX}}",
    "full": "Full name for Microsoft Learn Helper"
  },
  "description": {
    "short": "Short description for Microsoft Learn Helper",
    "full": "Full description for Microsoft Learn Helper"
  },
  "accentColor": "#FFFFFF",
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": [],
  "agentConnectors": [
    {
      "id": "microsoft-learn",
      "displayName": "Microsoft Learn",
      "description": "Search and read current official Microsoft documentation and code samples.",
      "toolSource": {
        "remoteMcpServer": {
          "mcpServerUrl": "https://learn.microsoft.com/api/mcp",
          "mcpToolDescription": {
            "file": "microsoft-learn-mcp-tools.json"
          }
        }
      }
    }
  ]
}
