# ---------- Server ----------
PORT=3001
# Public HTTPS base URL of your dev tunnel (no trailing slash), e.g. https://abc123-3001.aue.devtunnels.ms
PUBLIC_BASE_URL=http://localhost:3001

# ---------- Authentication ----------
# none  = Exercise 2 (anonymous, identity comes from the x-demo-user header or DEMO_USER)
# entra = Exercise 3+ (OAuth 2.0 bearer tokens issued by Microsoft Entra ID)
AUTH_MODE=none
DEMO_USER=E1001

# Entra ID (Exercise 3)
TENANT_ID=00000000-0000-0000-0000-000000000000
API_CLIENT_ID=00000000-0000-0000-0000-000000000000
REQUIRED_SCOPE=access_as_user
APPROVER_ROLE=Leave.Approve

# ---------- Account mappings (optional when using single-account testing) ----------
# E1001, E1002 and M2001 respectively; use different accounts for each mapping.
EMPLOYEE_UPN=
SECOND_EMPLOYEE_UPN=
MANAGER_UPN=

# ---------- Single-account workshop testing (never enable on a shared/production server) ----------
# Set TEST_USER_UPN to your own sign-in name, then run npm run demo:role -- user|manager|off.
# OAuth is still required in Entra mode; only this account gets a simulated persona and role.
TEST_USER_UPN=
SINGLE_ACCOUNT_DEMO=false
DEMO_PERSONA=user

# Optional: pretend "today" is a fixed date for repeatable demos (YYYY-MM-DD)
# TODAY=2026-11-25
