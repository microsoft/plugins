{
  "name": "fabrikam-leave-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Fabrikam People Hub - Leave MCP server with MCP Apps widgets (workshop sample)",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build:widgets": "node scripts/build-widgets.js",
    "seed": "node scripts/seed.js",
    "demo:role": "node --env-file-if-exists=.env scripts/switch-demo-role.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "export:tools": "node --env-file-if-exists=.env scripts/export-tool-descriptions.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "jose": "^5.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
